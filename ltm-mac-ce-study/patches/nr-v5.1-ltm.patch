+/**
+ * @ingroup utils
+ * @brief 6G LTM (Lower-layer Triggered Mobility) cell-switch command, modelled as an
+ *        unauthenticated Layer-2 MAC Control Element carried on the DL control channel.
+ *
+ * In 5G-Advanced / 6G LTM the serving cell issues the cell-switch trigger as a MAC CE that
+ * sits below PDCP, so it carries NO integrity protection and NO ciphering (unlike an
+ * RRC-commanded handover). The UE applies a pre-configured candidate target identified by a
+ * Target Configuration ID. Because the command is unauthenticated it can be forged by a
+ * symbol-synchronised overshadowing SDR (the attack modelled in this work): this same message
+ * class is what a legitimate gNB emits and what the attacker injects at the victim UE PHY.
+ */
+class NR_EXPORT NrLtmCellSwitchMessage : public NrControlMessage
+{
+  public:
+    NrLtmCellSwitchMessage();
+
+    void SetRnti(uint16_t rnti);          //!< target UE (unicast)
+    uint16_t GetRnti() const;
+    void SetTargetCellId(uint16_t cellId); //!< candidate target cell to switch to
+    uint16_t GetTargetCellId() const;
+    void SetTargetConfigId(uint16_t id);   //!< Target Configuration ID (the spoofable field)
+    uint16_t GetTargetConfigId() const;
+    void SetForged(bool forged);           //!< true if injected by the attacker (for tracing only)
+    bool GetForged() const;
+
+  private:
+    uint16_t m_rnti{0};
+    uint16_t m_targetCellId{0};
+    uint16_t m_targetConfigId{0};
+    bool m_forged{false};
+};
+
