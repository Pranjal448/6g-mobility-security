+void
+NrUePhy::InjectForgedLtmCellSwitch(uint16_t targetCellId, uint16_t targetConfigId)
+{
+    NS_LOG_FUNCTION(this << targetCellId << targetConfigId);
+    // Model the overshadowing attacker's capture-effect injection: a forged LTM cell-switch MAC
+    // CE is delivered to this UE's PHY as if received from the air. The UE has no way to
+    // authenticate it (below PDCP, no MAC-I), so it flows through the ordinary DL-control
+    // receive path and the UE acts on the attacker's spoofed Target Configuration ID.
+    Ptr<NrLtmCellSwitchMessage> msg = Create<NrLtmCellSwitchMessage>();
+    msg->SetSourceBwpArfcn(DoGetArfcn()); // the victim's serving BWP (overshadow is in-band)
+    msg->SetRnti(m_rnti);
+    msg->SetTargetCellId(targetCellId);
+    msg->SetTargetConfigId(targetConfigId);
+    msg->SetForged(true);
+    PhyCtrlMessagesReceived(msg);
+}
