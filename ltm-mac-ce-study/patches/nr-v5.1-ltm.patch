+void
+NrGnbPhy::SendLtmCellSwitch(uint16_t rnti, uint16_t targetCellId, uint16_t targetConfigId)
+{
+    NS_LOG_FUNCTION(this << rnti << targetCellId << targetConfigId);
+    // Build the LTM cell-switch MAC CE and enqueue it on the DL control channel with no extra
+    // latency (the lower-layer-triggered design point). It rides the air interface below PDCP,
+    // unauthenticated -- the very property the overshadowing attacker exploits.
+    Ptr<NrLtmCellSwitchMessage> msg = Create<NrLtmCellSwitchMessage>();
+    // Stamp the source BWP ARFCN: over-the-air control messages are routed at the UE by their
+    // source ARFCN (NrUeNetDevice::RouteIngoingCtrlMsgs aborts on arfcn==0).
+    msg->SetSourceBwpArfcn(DoGetArfcn());
+    msg->SetRnti(rnti);
+    msg->SetTargetCellId(targetCellId);
+    msg->SetTargetConfigId(targetConfigId);
+    msg->SetForged(false);
+    EnqueueCtrlMsgNow(msg);
+}
