+void
+NrUeRrc::AddLtmCandidate(uint16_t configId, uint16_t cellId)
+{
+    // Pre-configuration: store a candidate the serving cell provisioned in advance. The UE keeps
+    // these ready so a later cell-switch MAC CE can ACTIVATE one by its Target Configuration ID.
+    m_ltmCandidates[configId] = cellId;
+    NS_LOG_INFO("UE imsi=" << m_imsi << " pre-configured LTM candidate configId=" << configId
+                           << " -> cell " << cellId);
+}
+
+void
+NrUeRrc::DoRecvLtmCellSwitch(uint16_t targetCellId, uint16_t targetConfigId, bool forged)
+{
+    // 6G LTM lower-layer-triggered cell switch. The command arrived as an unauthenticated Layer-2
+    // MAC CE on the DL control channel; the UE cannot distinguish a legitimate command from a
+    // forged (overshadowed) one -- it acts on both (the vulnerability). In LTM the UE does NOT
+    // perform a fresh handover: it looks up the Target Configuration ID among the candidates the
+    // network pre-configured, and ACTIVATES that pre-provisioned candidate. A config ID with no
+    // matching pre-configured candidate -- exactly what a forged/spoofed Target Configuration ID
+    // carries -- cannot be activated: the UE has nothing valid to switch to.
+    NS_LOG_FUNCTION(this << targetCellId << targetConfigId << forged);
+    auto it = m_ltmCandidates.find(targetConfigId);
+    bool validCandidate = (it != m_ltmCandidates.end());
+    uint16_t candidateCell = validCandidate ? it->second : targetCellId;
+    NS_LOG_INFO("UE rnti=" << m_rnti << " cell=" << m_cellId
+                           << " LTM cell-switch: configId=" << targetConfigId
+                           << (validCandidate ? " ACTIVATES pre-configured candidate cell "
+                                              : " has NO pre-configured candidate (cell ")
+                           << candidateCell << (validCandidate ? "" : ")")
+                           << (forged ? " [FORGED]" : ""));
+    m_ltmCellSwitchReceivedTrace(m_imsi, m_cellId, m_rnti, candidateCell, targetConfigId, forged,
+                                 validCandidate);
+}
